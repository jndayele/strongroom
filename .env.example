# Strongroom Environment Configuration Template (Placeholders Only)
# NEVER put real secrets in this file or commit a .env file to version control.
# Production secrets must be stored only in Render environment secrets (PRD Section 10).

# Backend Server Bind Configuration
HOST=127.0.0.1
PORT=3000

# Frontend Origin (for strict CORS enforcement in Phase 1+)
APP_ORIGIN=http://localhost:5173
VITE_API_ORIGIN=http://localhost:3000

# Database Connection (Phase 1+ — Render private network URL in production)
DATABASE_URL=postgres://REPLACE_WITH_DB_USER:REPLACE_WITH_DB_PASSWORD@localhost:5432/strongroom_dev

# Server Cryptographic Secrets (Phase 1+ — generate via OS CSPRNG, store only in Render secrets)
OPAQUE_SERVER_SETUP_SECRET=REPLACE_WITH_BASE64_CSPRNG_SECRET
COOKIE_SIGNING_KEY=REPLACE_WITH_BASE64_CSPRNG_SECRET
TOTP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_CSPRNG_SECRET
EMAIL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_CSPRNG_SECRET
