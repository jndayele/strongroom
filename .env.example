# Strongroom API Environment Variables (Example)
# Copy to .env for local development. Never commit .env!

API_HOST=127.0.0.1
API_PORT=8080

# PostgreSQL database and role passwords for local development (used by infra/docker-compose.yml)
POSTGRES_DB=vault_dev
VAULT_MIGRATOR_PASSWORD=local_migrator_password_only
VAULT_APP_PASSWORD=local_app_password_only

# Application runtime connection string (least-privilege vault_app role — DML only, append-only audit_events)
DATABASE_URL=postgres://vault_app:local_app_password_only@127.0.0.1:5432/vault_dev

# Schema migration connection string (vault_migrator role — owns schema and runs SQLx migrations)
MIGRATOR_DATABASE_URL=postgres://vault_migrator:local_migrator_password_only@127.0.0.1:5432/vault_dev

LOG_LEVEL=info

# Cryptographic server secrets (base64url-encoded, required at startup).
# Generate fresh values locally with: cargo run -p strongroom-api --bin gen-secrets
# WARNING: Rotating OPAQUE_SERVER_SETUP or CREDENTIAL_ID_KEY invalidates every user's login!
# Rotating EMAIL_HASH_KEY invalidates all email_hash lookups in the users table.
OPAQUE_SERVER_SETUP=<replace-with-128-byte-base64url-from-gen-secrets>
CREDENTIAL_ID_KEY=<replace-with-32-byte-base64url-from-gen-secrets>
EMAIL_HASH_KEY=<replace-with-32-byte-base64url-from-gen-secrets>
